diff --git a/CMakeLists.txt b/CMakeLists.txt
index 95bfee5..604c1cd 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -115,15 +115,10 @@ function(rex_config_postfix target)
 endfunction()
 
 if(NOT WIN32)
-    # Use appropriate code model based on architecture
-    if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64|x86_64" AND NOT APPLE)
-        # Large code model on Linux x86_64 for linking with very large recompiled executables (35MB+).
-        # macOS uses small: the ld64 linker on macOS 15+ rejects text relocations produced
-        # by -mcmodel=large, and macOS maps binaries in the low address space so ±2GB is sufficient.
-        add_compile_options(-mcmodel=large)
-    else()
-        add_compile_options(-mcmodel=small)
-    endif()
+    # Small code model everywhere: it reaches ±2 GB, and a recompiled game's code is tens of MB.
+    # The large model made every call and global access on Linux x86_64 an absolute 64-bit
+    # address through a register.
+    add_compile_options(-mcmodel=small)
     # Position-independent code for all targets
     set(CMAKE_POSITION_INDEPENDENT_CODE ON)
 endif()
diff --git a/cmake/rexglue_helpers.cmake b/cmake/rexglue_helpers.cmake
index 816c329..5f75adc 100644
--- a/cmake/rexglue_helpers.cmake
+++ b/cmake/rexglue_helpers.cmake
@@ -46,11 +46,8 @@ endfunction()
 #==========================================================
 function(rexglue_apply_target_settings target_name)
     if(UNIX AND NOT APPLE)
-        # Large executable support
-        if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
-            target_link_options(${target_name} PRIVATE -Wl,--no-relax)
-            target_compile_options(${target_name} PRIVATE -mcmodel=large)
-        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|ARM64" AND NOT ANDROID)
+        # No large code model on x86_64: the small model reaches ±2 GB of code (see CMakeLists.txt).
+        if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|ARM64" AND NOT ANDROID)
             # Not on Android: its builds pass -march=armv8.2-a (LSE atomics) in the toolchain
             # flags, and a later -march=armv8-a here would lower it again.
             target_compile_options(${target_name} PRIVATE -march=armv8-a)
