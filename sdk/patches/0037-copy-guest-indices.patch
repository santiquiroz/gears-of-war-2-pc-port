+bool PrimitiveProcessor::CopyGuestIndicesToHost(uint32_t guest_index_base, uint32_t index_count,
+                                                xenos::IndexFormat format, xenos::Endian endian,
+                                                bool primitive_reset_enabled, CachedResult& cacheable) {
+  CacheTransaction cache_transaction(
+      *this, CacheKey(guest_index_base, index_count, format, endian, primitive_reset_enabled,
+                      xenos::PrimitiveType::kNone, true));
+  if (cache_transaction.GetFoundResult()) {
+    cacheable = *cache_transaction.GetFoundResult();
+    return true;
+  }
+  void* host_indices = RequestHostConvertedIndexBufferForCurrentFrame(
+      format, index_count, false, guest_index_base, cacheable.host_index_buffer_handle);
+  if (!host_indices) {
+    return false;
+  }
+  if (format == xenos::IndexFormat::kInt16) {
+    // The caller already reduced 16-bit endian modes to none or 8-in-16.
+    auto guest = memory_.TranslatePhysical<const uint16_t*>(guest_index_base);
+    auto host = static_cast<uint16_t*>(host_indices);
+    bool swap = endian == xenos::Endian::k8in16;
+    for (uint32_t i = 0; i < index_count; ++i) {
+      host[i] = swap ? uint16_t((guest[i] >> 8) | (guest[i] << 8)) : guest[i];
+    }
+  } else {
+    auto guest = memory_.TranslatePhysical<const uint32_t*>(guest_index_base);
+    auto host = static_cast<uint32_t*>(host_indices);
+    for (uint32_t i = 0; i < index_count; ++i) {
+      host[i] = xenos::GpuSwap(guest[i], endian) & xenos::kVertexIndexMask;
+    }
+  }
+  cacheable.index_buffer_type = ProcessedIndexBufferType::kHostConverted;
+  cacheable.host_index_format = format;
+  cacheable.host_shader_index_endian = xenos::Endian::kNone;
+  cache_transaction.SetNewResult(cacheable);
+  return true;
+}
