diff --git a/include/rex/input/input_system.h b/include/rex/input/input_system.h
index 1cb3faa..8adcda6 100644
--- a/include/rex/input/input_system.h
+++ b/include/rex/input/input_system.h
@@ -71,4 +71,14 @@ class InputSystem : public system::IInputSystem {
 /// In tool mode, only the NOP driver is added.
 std::unique_ptr<InputSystem> CreateDefaultInputSystem(bool tool_mode);
 
+// Physical controller activity across the input drivers (SDL, XInput): the host uptime in
+// milliseconds (rex::chrono::Clock::QueryHostUptimeMillis) of the last button press or
+// stick/trigger movement past a threshold, and the SDL_GamepadType of that controller (0 when
+// unknown). Emulated pads (keyboard and mouse, touch) never report here.
+void NotePhysicalPadActivity(int sdl_gamepad_type);
+// A controller connected: sets only the type.
+void NotePhysicalPadType(int sdl_gamepad_type);
+// out_sdl_gamepad_type may be null; time 0 = no activity yet.
+uint64_t LastPhysicalPadActivity(int* out_sdl_gamepad_type);
+
 }  // namespace rex::input
diff --git a/src/input/input_system.cpp b/src/input/input_system.cpp
index a7d5907..fe81f99 100644
--- a/src/input/input_system.cpp
+++ b/src/input/input_system.cpp
@@ -10,9 +10,11 @@
  */
 
 #include <algorithm>
+#include <atomic>
 #include <cmath>
 #include <mutex>
 
+#include <rex/chrono/clock.h>
 #include <rex/dbg.h>
 #include <rex/input/device_assignment.h>
 #include <rex/input/flags.h>
@@ -389,4 +391,36 @@ std::unique_ptr<InputSystem> CreateDefaultInputSystem(bool tool_mode) {
   return input;
 }
 
+// File-static rather than InputDriver members: gow2.exe subclasses InputDriver against the
+// unpatched headers, so the class layout and vtable must not change.
+static std::atomic<uint64_t> last_physical_pad_activity_ms{0};
+static std::atomic<int> last_physical_pad_type{0};
+
+void NotePhysicalPadActivity(int sdl_gamepad_type) {
+  last_physical_pad_type.store(sdl_gamepad_type, std::memory_order_relaxed);
+  last_physical_pad_activity_ms.store(rex::chrono::Clock::QueryHostUptimeMillis(),
+                                      std::memory_order_relaxed);
+}
+
+void NotePhysicalPadType(int sdl_gamepad_type) {
+  last_physical_pad_type.store(sdl_gamepad_type, std::memory_order_relaxed);
+}
+
+uint64_t LastPhysicalPadActivity(int* out_sdl_gamepad_type) {
+  if (out_sdl_gamepad_type) {
+    *out_sdl_gamepad_type = last_physical_pad_type.load(std::memory_order_relaxed);
+  }
+  return last_physical_pad_activity_ms.load(std::memory_order_relaxed);
+}
+
 }  // namespace rex::input
+
+#if defined(_WIN32)
+#define REX_INPUT_EXPORT __declspec(dllexport)
+#else
+#define REX_INPUT_EXPORT __attribute__((visibility("default")))
+#endif
+
+extern "C" REX_INPUT_EXPORT uint64_t rex_input_get_last_physical_activity(int* out_type) {
+  return rex::input::LastPhysicalPadActivity(out_type);
+}
