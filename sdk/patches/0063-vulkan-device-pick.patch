+  if (!provider->vulkan_device_) {
+    std::string wanted = REXCVAR_GET(vulkan_device_name);
+    if (!wanted.empty()) {
+      std::string wanted_lower = wanted;
+      std::transform(wanted_lower.begin(), wanted_lower.end(), wanted_lower.begin(),
