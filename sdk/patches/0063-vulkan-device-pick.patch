+        std::transform(name_lower.begin(), name_lower.end(), name_lower.begin(),
+                       [](unsigned char c) { return std::tolower(c); });
+        if (name_lower.find(wanted_lower) == std::string::npos) {
+          continue;
+        }
+        provider->vulkan_device_ = VulkanDevice::CreateIfSupported(
