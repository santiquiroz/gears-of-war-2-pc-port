+    // Through WriteRegister, like type-0 packets, so the backend's register write hooks run; only the
+    // registers that change, since a fetch constant write invalidates that slot's cached resources.
+    auto write = [this](uint32_t first, const uint32_t* values, uint32_t n) {
+      for (uint32_t i = 0; i < n; ++i) {
+        if (register_file_->values[first + i] != values[i]) {
+          WriteRegister(first + i, values[i]);
+        }
+      }
+    };
+    write(0x2000, snapshot->surf, 6);
+    write(0x2180, snapshot->prog, 2);
+    write(0x2200, snapshot->rs, 12);
+    write(0x2100, snapshot->vp, 21);
+    write(0x2081, snapshot->scissor, 2);
+    write(0x4800, snapshot->fetch, 192);
+    for (uint32_t i = 0; i < 128; ++i) {
+      if (snapshot->alu[i]) {
+        write(0x4000 + 16 * i, snapshot->alu[i], 16);
+      }
+    }
+
+    ++stats.draws;
+    g_decoded_draw_words = snapshot->draw_words;
+    bool result = ExecutePacketType3_DRAW_INDX(nullptr, packet, 4);
+    g_decoded_draw_words = nullptr;
+    return result;
+  }
