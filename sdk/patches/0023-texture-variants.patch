+  const std::string wanted = REXCVAR_GET(texture_replace_variant);
+  if (wanted == active_variant_) {
+    return false;
+  }
+  active_variant_ = wanted;
+  variant_paths_.clear();
+  variant_images_.clear();
+  if (!wanted.empty()) {
+    ScanDir(title_dir_ / ("replace_" + wanted), &variant_paths_);
+    variant_was_active_ = true;
+  }
+  ++variant_epoch_;
+  REXLOG_INFO("[texpack] variant '{}' ({} files)", wanted, variant_paths_.size());
+  return true;
+}
