+void TextureReplacementManager::LogPrecacheStats() {
+  if (!precache_enabled_)
+    return;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - precache_last_report_ < std::chrono::seconds(10))
+    return;
+  precache_last_report_ = now;
+  if (precache_hits_ == precache_last_report_hits_ &&
+      precache_cold_reads_ == precache_last_report_cold_)
+    return;
+  precache_last_report_hits_ = precache_hits_;
+  precache_last_report_cold_ = precache_cold_reads_;
+  REXLOG_INFO(
+      "GOW2PRECACHE use: {} prepared hits, {} on-demand reads, {} prepared images remaining ({} "
+      "MB)",
+      precache_hits_, precache_cold_reads_, prepared_images_.size(), precache_pending_bytes_ >> 20);
+}
