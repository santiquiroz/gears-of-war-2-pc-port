+void VulkanSharedMemory::OnRangesRequested(const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  if (!host_mapping_) {
+    return;
+  }
+  const uint64_t submission = command_processor_.GetCurrentSubmission();
+  const uint32_t block_shift = page_size_log2() + 6;
+  for (const auto& range : ranges) {
+    for (uint32_t block = range.first >> block_shift;
+         block <= (range.first + range.second - 1) >> block_shift; ++block) {
+      block_last_use_[block] = submission;
+    }
+  }
+}
+
+bool VulkanSharedMemory::IsBlockRangeIdleOnGpu(uint32_t page_first, uint32_t page_count) const {
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  for (uint32_t block = page_first >> 6; block <= (page_first + page_count - 1) >> 6; ++block) {
+    if (block_last_use_[block] > completed) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void VulkanSharedMemory::ReportHostWrites() {
+  static auto since = std::chrono::steady_clock::now();
+  auto now = std::chrono::steady_clock::now();
+  if (now - since < std::chrono::seconds(5)) {
+    return;
+  }
+  REXGPU_INFO("SHMHOST written {} copied {}", host_written_uploads_, copied_uploads_);
+  host_written_uploads_ = 0;
+  copied_uploads_ = 0;
+  since = now;
+}
+
 void VulkanSharedMemory::CompletedSubmissionUpdated() {
   upload_buffer_pool_->Reclaim(command_processor_.GetCompletedSubmission());
 }
