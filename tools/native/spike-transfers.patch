+// SPIKE: why 4x draws are not eligible, as a bit mask, logged every 4096 4x draws.
+void SpikeMsaaFillDiag(const RegisterFile& regs, const Shader* vs, const Shader* ps) {
+  auto spike_mode = regs.Get<reg::RB_MODECONTROL>().edram_mode;
+  if ((spike_mode != xenos::EdramMode::kColorDepth && spike_mode != xenos::EdramMode::kDepthOnly) ||
+      regs.Get<reg::RB_SURFACE_INFO>().msaa_samples != xenos::MsaaSamples::k4X) {
+    return;
+  }
+  uint32_t mask = 0;
+  if (!g_vertex_shader_embedded) mask |= 1;
+  if (!g_pixel_shader_embedded) mask |= 2;
+  if (!vs || !vs->is_ucode_analyzed()) mask |= 4;
+  else if (!IsConstantFillShader(vs)) mask |= 8;
+  if (ps && !ps->is_ucode_analyzed()) mask |= 16;
+  else if (ps && !IsConstantFillShader(ps)) mask |= 32;
+  if (ps && ps->is_ucode_analyzed() && (ps->writes_depth() || ps->kills_pixels())) mask |= 64;
+  auto color_control = regs.Get<reg::RB_COLORCONTROL>();
+  if (color_control.alpha_test_enable || color_control.alpha_to_mask_enable) mask |= 128;
+  auto mode = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (mode.poly_offset_front_enable || mode.poly_offset_back_enable) mask |= 256;
+  if (mode.poly_mode != xenos::PolygonModeEnable::kDisabled) mask |= 512;
+  if (!RasterizesLikeAFill(regs)) mask |= 1024;
+  if (ps && ps->is_ucode_analyzed() && !ColorWritesReplace(regs, ps)) mask |= 2048;
+  if (!FitsAtTwiceTheSize(regs)) mask |= 4096;
+  static std::map<uint64_t, uint32_t> counts;
+  static uint32_t total = 0;
+  ++counts[(uint64_t(mask) << 32) | regs[XE_GPU_REG_RB_DEPTHCONTROL]];
+  if ((++total & 0xFFF) == 0) {
+    for (const auto& [m, c] : counts) {
+      REXGPU_INFO("SPIKEFILL mask {:04X} dc {:08X} count {}", uint32_t(m >> 32), uint32_t(m), c);
+    }
+    counts.clear();
+  }
+}
