+namespace {
+// SPIKE (native renderer phase 2, not for commit): which EDRAM ownership transfers happen, by kind.
+struct SpikeTransferStats {
+  uint64_t count = 0;
+  uint64_t tiles = 0;
+};
+using SpikeTransferKey = std::tuple<uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t>;
+std::map<SpikeTransferKey, SpikeTransferStats> g_spike_transfers;
+std::chrono::steady_clock::time_point g_spike_transfers_since = std::chrono::steady_clock::now();
+uint64_t g_spike_transfer_calls = 0;
+const auto g_spike_seq_start = std::chrono::steady_clock::now();
+uint64_t g_spike_seq_call = 0;
+
+// One frame's worth of ownership changes, 90 s after the first draw (the hospital in native-ceiling.ps1).
+bool SpikeSeqActive() {
+  const double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_spike_seq_start).count();
+  return t >= 45.0 && uint64_t(t * 1000.0) % 15000 < 11;
+}
+
+std::string SpikeKeyText(uint32_t key_bits) {
+  const uint32_t base = key_bits & 0x7FF, pitch = (key_bits >> 11) & 0xFF, msaa = (key_bits >> 19) & 3,
+                 depth = (key_bits >> 21) & 1, fmt = (key_bits >> 22) & 0xF;
+  return fmt::format("{}{}x{}@{}/p{}", depth ? 'D' : 'C', fmt, 1u << msaa, base, pitch);
+}
+
+void SpikeReportTransfers() {
+  const auto now = std::chrono::steady_clock::now();
+  const double seconds = std::chrono::duration<double>(now - g_spike_transfers_since).count();
+  if (seconds < 5.0) return;
+  for (const auto& [key, stats] : g_spike_transfers) {
+    const auto [sd, sf, sm, dd, df, dm] = key;
+    REXGPU_INFO("SPIKEXFER {} fmt {} msaa {} -> {} fmt {} msaa {}: {:.1f}/s, {:.0f} tiles/s",
+                sd ? "depth" : "color", sf, sm, dd ? "depth" : "color", df, dm, stats.count / seconds,
+                stats.tiles / seconds);
+  }
+  REXGPU_INFO("SPIKEXFER --- {:.1f} calls/s over {:.1f} s", g_spike_transfer_calls / seconds, seconds);
+  g_spike_transfers.clear();
+  g_spike_transfer_calls = 0;
+  g_spike_transfers_since = now;
+}
+}  // namespace
