+namespace {
+
+// EXPERIMENT (native renderer phase 2): whether the draw replaces every bit of this render target without
+// reading it, so the EDRAM contents a transfer would bring are dead. Direct3D's ClearF always passes the
+// whole surface as its rectangle (measured in the chapter 2 hospital), so for its internal draws the state
+// decides: colour needs all four channels and no blending; depth needs an ALWAYS depth write and, as
+// depth and stencil share the target, a stencil REPLACE of all eight bits (a stencil-only clear keeps the
+// depth, a depth-only clear keeps the stencil).
+bool DrawReplacesDepthStencil(const RegisterFile& regs, reg::RB_DEPTHCONTROL depth_control) {
+  if (!depth_control.z_enable || !depth_control.z_write_enable ||
+      depth_control.zfunc != xenos::CompareFunction::kAlways || !depth_control.stencil_enable) {
+    return false;
+  }
+  auto stencil = regs.Get<reg::RB_STENCILREFMASK>();
+  return depth_control.stencilfunc == xenos::CompareFunction::kAlways &&
+         depth_control.stencilzpass == xenos::StencilOp::kReplace && stencil.stencilwritemask == 0xFF;
+}
+
+bool DrawReplacesColor(const RegisterFile& regs, uint32_t color_mask, uint32_t rt_index) {
+  if (((color_mask >> (4 * rt_index)) & 0b1111) != 0b1111) {
+    return false;
+  }
+  auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[rt_index]);
+  return blend.color_srcblend == xenos::BlendFactor::kOne &&
+         blend.color_destblend == xenos::BlendFactor::kZero &&
+         blend.color_comb_fcn == xenos::BlendOp::kAdd &&
+         blend.alpha_srcblend == xenos::BlendFactor::kOne &&
+         blend.alpha_destblend == xenos::BlendFactor::kZero;
+}
+
+bool InternalDrawReplaces(const RegisterFile& regs, reg::RB_DEPTHCONTROL depth_control, uint32_t color_mask,
+                          uint32_t rt_bit_index) {
+  if (!g_gpu_internal_vertex_shader || !g_gpu_internal_pixel_shader) {
+    return false;
+  }
+  return rt_bit_index == 0 ? DrawReplacesDepthStencil(regs, depth_control)
+                           : DrawReplacesColor(regs, color_mask, rt_bit_index - 1);
+}
