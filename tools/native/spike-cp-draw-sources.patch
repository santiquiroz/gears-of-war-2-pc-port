+namespace {
+// SPIKE (native renderer phase 0, not for commit): where the draws come from.
+struct SpikeIb {
+  uint32_t runs = 0;
+  uint32_t draws = 0;     // draw packets executed inside, all runs
+  uint32_t first_run_draws = 0;
+};
+std::unordered_map<uint32_t, SpikeIb> g_spike_frame_ibs;    // this frame, by guest pointer
+std::unordered_map<uint32_t, uint32_t> g_spike_ib_frames;   // how many reported windows saw each pointer
+uint32_t g_spike_current_ib = 0;
+uint64_t g_spike_pred_draws = 0, g_spike_swaps = 0;
+uint64_t g_spike_nonpred_mode[8] = {}, g_spike_pred_mode[8] = {};
+uint64_t g_spike_acc_runs = 0, g_spike_acc_distinct = 0, g_spike_acc_draws = 0, g_spike_acc_first = 0,
+         g_spike_acc_reruns = 0;
+
+void SpikeEndFrame() {
+  for (auto& [ptr, ib] : g_spike_frame_ibs) {
+    g_spike_acc_runs += ib.runs;
+    ++g_spike_acc_distinct;
+    g_spike_acc_draws += ib.draws;
+    g_spike_acc_first += ib.first_run_draws;
+    if (ib.runs > 1) ++g_spike_acc_reruns;
+    ++g_spike_ib_frames[ptr];
+  }
+  g_spike_frame_ibs.clear();
+}
+}  // namespace
